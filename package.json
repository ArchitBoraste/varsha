{
  "name": "varsha",
  "version": "0.1.0",
  "private": true,
  "description": "Regime-aware rainfall forecast post-processing demo for India (SIH 2026, PS 26080)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors blue,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "data": "node scripts/prepare-geo.js && node scripts/generate-data.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "mapshaper": "^0.7.70",
    "vite": "^8.3.1"
  }
}
