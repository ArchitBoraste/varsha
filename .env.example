# Ask Varsha server settings. Copy this file to .env and fill in one key; .env is never committed.
# Without a key the assistant answers the common questions with rule-based replies.

# gemini (default) or anthropic
LLM_PROVIDER=gemini

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-latest (Google's current Flash model).
GEMINI_MODEL=

# Key from the Claude Console: https://platform.claude.com/
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional; the API server's port (Vite proxies /api to it).
API_PORT=8787
